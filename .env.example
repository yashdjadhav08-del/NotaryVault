# NotaryVault MST Chain Multi-Network Configuration
# Copy this file to .env and configure your deployer private key before running deployment.
# NEVER commit your actual .env file or private key to version control.
# Never request or share private keys in chat.

# Required: Deployer Account Private Key (Hexadecimal format with or without 0x prefix)
# The account MUST have native MSTC to pay for gas fees on the target network.
DEPLOYER_PRIVATE_KEY=

# --- MST Chain Testnet Parameters ---
# Chain ID: 91562037 (0x5752035)
# Explorer: https://testnet.mstscan.com
MST_TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
MST_TESTNET_CHAIN_ID=91562037

# --- MST Chain Mainnet Parameters ---
# Chain ID: 4646 (0x1226)
# Explorer: https://mstscan.com
MST_MAINNET_RPC_URL=https://4646.rpc.thirdweb.com
MST_MAINNET_CHAIN_ID=4646
