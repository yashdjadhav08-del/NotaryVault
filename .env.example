# NotaryVault MST Chain Multi-Network & Production Deployment Configuration
# Copy this file to .env and configure for your local development or production container.
# NEVER commit your actual .env file or private keys to version control.

# ==============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Vite)
# Set these in your Vercel Project Settings > Environment Variables
# ==============================================================================

# URL of your deployed Node.js backend storage and authentication server
# Local dev: http://localhost:5001
# Production: https://api.notaryvault.yourdomain.com or https://notaryvault-api.onrender.com
VITE_STORAGE_SERVER_URL=http://localhost:5001

# Alternative alias for VITE_STORAGE_SERVER_URL (supported for backwards compatibility)
# VITE_STORAGE_BACKEND_URL=http://localhost:5001

# ==============================================================================
# 2. BACKEND SERVER CONFIGURATION (Render / Railway / Docker / Fly.io)
# ==============================================================================

# HTTP Port the server listens on
PORT=5001
STORAGE_SERVER_PORT=5001

# Production Web Application Root URL (Used for generating access links in emails)
# Example: https://notary-vault-woad.vercel.app
PUBLIC_APP_URL=http://localhost:5173

# CORS Whitelist: Comma-separated list of allowed frontend origins
# Example: https://notary-vault-woad.vercel.app,https://*.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://notary-vault-woad.vercel.app

# Persistent Storage Provider: 'local' (filesystem / persistent volume) or 's3' (AWS S3, Cloudflare R2, MinIO, Supabase)
STORAGE_PROVIDER=local

# Local Storage Directories (when STORAGE_PROVIDER=local or fallback)
STORAGE_DIR=storage
UPLOADS_DIR=storage/uploads
DATABASE_PATH=storage/notaryvault.db

# Cloud Object Storage Configuration (Required when STORAGE_PROVIDER=s3)
# Works with Cloudflare R2, AWS S3, Backblaze B2, Supabase Storage, MinIO
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=notaryvault-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Cryptographic Session & Token Signing Secret
AUTH_SESSION_SECRET=notaryvault_change_this_to_a_long_random_secret_in_production

# ==============================================================================
# 3. BLOCKCHAIN CONFIGURATION (MST Chain)
# ==============================================================================

# MST Chain Testnet (Chain ID: 91562037 / 0x5752035)
MST_TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
MST_TESTNET_CHAIN_ID=91562037

# MST Chain Mainnet (Chain ID: 4646 / 0x1226)
MST_MAINNET_RPC_URL=https://mariorpc.mstblockchain.com
MST_MAINNET_CHAIN_ID=4646

# Deployer Private Key (Only needed when running deployment scripts locally)
# NEVER configure this on public hosting or commit to GitHub.
# DEPLOYER_PRIVATE_KEY=

# ==============================================================================
# 4. EMAIL NOTIFICATION PROVIDER (Resend / SMTP)
# ==============================================================================

# Provider selection: 'resend' or 'smtp'
EMAIL_PROVIDER=resend

# Resend API Key (https://resend.com)
RESEND_API_KEY=

# Sender Identity:
# NOTE: Resend requires a verified custom domain (https://resend.com/domains) with SPF/DKIM DNS records
# to send emails to arbitrary external recipients.
# Example verified sender: EMAIL_FROM=NotaryVault <notifications@yourdomain.com>
# When using unverified sandbox (onboarding@resend.dev), Resend strictly restricts delivery to the account owner's email.
EMAIL_FROM=NotaryVault <onboarding@resend.dev>

# Alternative SMTP Configuration (Uncomment if EMAIL_PROVIDER=smtp):
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ==============================================================================
# 5. SMS NOTIFICATION PROVIDER (Twilio)
# ==============================================================================
# Mobile/SMS sharing is currently marked as 'Coming Soon' in the UI.
# Backend integration is ready when carrier registration is active.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
