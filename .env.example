# NotaryVault MST Chain Multi-Network Configuration
# Copy this file to .env and configure your deployer private key before running deployment.
# NEVER commit your actual .env file or private key to version control.
# Never request or share private keys in chat.

# Required: Deployer Account Private Key (Hexadecimal format with or without 0x prefix)
# The account MUST have native MSTC to pay for gas fees on the target network.
DEPLOYER_PRIVATE_KEY=

# --- MST Chain Testnet Parameters ---
# Chain ID: 91562037 (0x5752035)
# Explorer: https://testnet.mstscan.com
MST_TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
MST_TESTNET_CHAIN_ID=91562037

# --- MST Chain Mainnet Parameters ---
# Chain ID: 4646 (0x1226)
# Explorer: https://mstscan.com
MST_MAINNET_RPC_URL=https://4646.rpc.thirdweb.com
MST_MAINNET_CHAIN_ID=4646

# --- Local PDF Storage & Authentication Server Configuration ---
STORAGE_SERVER_PORT=5001
PORT=5001
VITE_STORAGE_SERVER_URL=http://localhost:5001
UPLOADS_DIR=uploads
AUTH_SESSION_SECRET=notaryvault_local_dev_session_secret_change_in_production

# --- Email Notification Provider Configuration (Resend) ---
# Belongs to: Resend Email Provider (https://resend.com)
# Real credentials must ONLY be stored in your private .env file; NEVER commit real keys.
# If unconfigured, the system reports "Notification provider not configured" without pretending delivery.
# NOTE: Resend requires a verified domain (https://resend.com/domains).
# For testing without a custom domain, use: EMAIL_FROM=NotaryVault <onboarding@resend.dev> (delivers to your Resend account email).
# Public webmail domains (like @gmail.com or @yahoo.com) cannot be used as the sender with Resend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=NotaryVault <onboarding@resend.dev>

# Or Alternative SMTP configuration:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# --- SMS Notification Provider Configuration (Twilio) ---
# Belongs to: Twilio SMS Provider (https://twilio.com)
# Real credentials must ONLY be stored in your private .env file; NEVER commit real keys.
# If unconfigured, the system reports "Notification provider not configured" without pretending delivery.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

